# Demo mode runs without credentials and stores reviewer actions in this browser.
NEXT_PUBLIC_DEMO_MODE=true
# Connected mode: set demo mode to false and provide both values below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only analytics ingestion/assignment and seed script. Never NEXT_PUBLIC_.
# Server-only Supabase secret key (sb_secret_...) or enabled legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Required when running the seed script; choose a strong local demo password.
SEED_PASSWORD=
# Server-only, random signing secret (32+ characters) for visitor cookies in connected mode.
ANALYTICS_COOKIE_SECRET=
# Optional local demo access (server-only; no defaults). Generate independent random keys.
DEMO_SESSION_SECRET=
DEMO_INTERNAL_ACCESS_KEY=
# Secure by default in production. Set false ONLY for local HTTP production testing.
DEMO_SECURE_COOKIES=true
# Private connected seed owner credential, different from public reviewer SEED_PASSWORD.
SEED_INTERNAL_PASSWORD=
