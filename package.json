{
  "name": "circles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader=native --pool=threads",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "seed:check": "node --import tsx scripts/seed.ts --dry-run"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "lucide-react": "latest",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vitest": "latest"
  }
}
